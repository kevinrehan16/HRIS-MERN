// prisma/schema.prisma

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Employee {
  id                    Int              @id @default(autoincrement())
  employeeId            String           @unique
  
  // --- Account Info ---
  email                 String           @unique
  password              String
  role                  Role             @default(EMPLOYEE)
  
  // --- Personal Info (Standard PH Format) ---
  firstName             String
  lastName              String
  middleName            String?          // New
  extensionName         String?          // New (Jr., Sr.)
  birthDate             DateTime?        // New
  gender                Gender?          // New
  civilStatus           CivilStatus?     @default(SINGLE) // New
  contactNo             String?          // New
  address               String?          @db.Text // New
  
  // --- Government / Statutory IDs (New) ---
  tinNo                 String?          @unique
  sssNo                 String?          @unique
  philhealthNo          String?          @unique
  pagibigNo             String?          @unique
  
  // --- Employment Info ---
  dateHired             DateTime         @default(now()) // New
  dateResigned          DateTime?        // New
  status                EmployeeStatus   @default(PROBATIONARY)
  employmentType        EmploymentType   @default(FULL_TIME) // New
  
  // --- Compensation (Decimal is better for money) ---
  basicSalary           Decimal          @default(0.0) @db.Decimal(12, 2)
  allowance             Decimal          @default(0.0) @db.Decimal(12, 2)
  leaveCredits          Float            @default(15.0)
  
  // --- Security ---
  faceDescriptor        String?          @db.LongText 
  
  // --- Relations ---
  departmentId          Int?
  department            Department?      @relation(fields: [departmentId], references: [id])
  positionId            Int?
  position              Position?        @relation(fields: [positionId], references: [id])
  scheduleId            Int?
  schedule              Schedule?        @relation(fields: [scheduleId], references: [id])
  
  // --- Transaction Arrays ---
  attendances           Attendance[]
  leaves                LeaveRequest[]
  payrolls              Payroll[]
  attendanceCorrections AttendanceCorrection[]
  documents             Document[]       // Link to the new model
  
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
}

model Department {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  description String?
  positions Position[] // Bawat Department ay may listahan ng Positions
  employees Employee[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now()) @updatedAt
}

model Position {
  id          Int        @id @default(autoincrement())
  title       String     @unique
  description String?
  // Salary Fields
  minSalary    Decimal    @default(0.0) @db.Decimal(10, 2)
  maxSalary    Decimal    @default(0.0) @db.Decimal(10, 2)
  // Relation to Department
  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id])
  employees   Employee[]
  createdAt   DateTime   @default(now())
}

model Attendance {
  id               Int              @id @default(autoincrement())
  date             DateTime         @default(now()) // Para sa YYYY-MM-DD
  timeIn           DateTime         @default(now())
  timeOut          DateTime?
  status           AttendanceStatus @default(PRESENT) // PRESENT, LATE, ABSENT, ON_LEAVE
  lateMinutes      Int              @default(0)  // Para madaling i-multiply sa hourly rate
  undertimeMinutes Int              @default(0)  // Para sa deduction sa payroll
  isUndertime      Boolean          @default(false)
  overtimeMinutes  Int              @default(0)
  otStatus         OTStatus         @default(NONE) // NONE, PENDING, APPROVED, REJECTED
  remarks          String?          // Halimbawa: "Late due to traffic"
  otApprovedBy     String?
  otRemarks        String?          // Reason kung bakit ni-reject (e.g., "No work done")
  
  // Relations
  employeeId       Int
  employee         Employee         @relation(fields: [employeeId], references: [id])
  corrections      AttendanceCorrection[]

  // Enterprise Rule: Isang attendance record lang per employee per day
  @@unique([employeeId, date]) 
}

model Schedule {
  id             Int        @id @default(autoincrement())
  name           String     @unique // Halimbawa: "Morning Shift", "Night Shift"
  shiftStart     String     // Format: "08:00" (HH:mm)
  shiftEnd       String     // Format: "17:00"
  gracePeriod    Int        @default(15) // Minutes bago maging "LATE"
  breakDuration  Int        @default(60) // New: Duration in minutes
  restDays       String     @default("Saturday,Sunday")
  employees      Employee[]
}

model LeaveRequest {
  id           Int         @id @default(autoincrement())
  startDate    DateTime
  endDate      DateTime
  type         LeaveType
  reason       String      @db.Text
  status       LeaveStatus @default(PENDING)
  adminRemarks String?     // Bakit na-reject? O anong bilin ng Admin?
  
  // Relations
  employeeId   Int
  employee     Employee    @relation(fields: [employeeId], references: [id])
  
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Payroll {
  id                  Int      @id @default(autoincrement())
  employeeId          Int
  employee            Employee @relation(fields: [employeeId], references: [id])
  
  periodStart         DateTime
  periodEnd           DateTime
  
  // Earnings
  basicPay            Float    // (Monthly Basic / 2) for semi-monthly
  overtimePay         Float    @default(0.0)
  
  // Deductions
  absentDeduction     Float    @default(0.0)
  lateDeduction       Float    @default(0.0)
  undertimeDeduction  Float    @default(0)
  sss                 Float    @default(0.0)
  philhealth          Float    @default(0.0)
  pagibig             Float    @default(0.0)
  withholdingTax      Float    @default(0)
  nightDiffPay        Float    @default(0)
  holidayPay          Float    @default(0)
  allowances          Float    @default(0) // (Non-taxable usually)
  grossPay            Float    @default(0.0) // <--- Added (Crucial for reporting)
  accrued13thMonth    Float    @default(0)
  accruedOtherBonuses Float    @default(0)
  
  netPay              Float
  status              PayrollStatus  @default(PENDING) // PENDING, PAID, VOID
  remarks             String?       @db.Text // <--- Added for audit trail
  createdAt           DateTime @default(now())
}

model Holiday {
  id          Int      @id @default(autoincrement())
  date        DateTime @unique // Ang mismong petsa ng holiday
  name        String   // Halimbawa: "Christmas Day" o "Labor Day"
  type        String   @default("REGULAR") // REGULAR, SPECIAL_NON_WORKING
  createdAt   DateTime @default(now())
}

model AttendanceCorrection {
  id               Int            @id @default(autoincrement())
  attendanceId     Int
  employeeId       Int
  
  // Anong type ng correction?
  type             CorrectionType @default(BOTH)
  
  // Ang bagong oras na nire-request
  requestedTimeIn  DateTime?
  requestedTimeOut DateTime?
  
  // Bakit kailangan itama?
  reason           String         @db.Text
  
  // Status ng request (Gagamit ng Enum)
  status           RequestStatus  @default(PENDING)
  
  adminRemarks     String?        @db.Text
  
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  // Relations
  attendance       Attendance     @relation(fields: [attendanceId], references: [id])
  employee         Employee       @relation(fields: [employeeId], references: [id])
}

model Document {
  id          Int      @id @default(autoincrement())
  name        String   // Hal: "NBI Clearance", "Resume"
  fileUrl     String   // Link kung saan naka-save yung file
  category    String?  // Hal: "Legal", "Recruitment"
  employeeId  Int
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

// ENUMS HERE...
enum PayrollStatus {
  PENDING
  APPROVED
  PAID
  VOID
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  ON_LEAVE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum EmployeeStatus {
  REGULAR
  PROBATIONARY
  CONTRACTUAL
  TERMINATED
}

enum Role {
  ADMIN      // Pwedeng mag-CRUD ng lahat
  EMPLOYEE   // Pwedeng makita lang ang sariling data
}

enum LeaveType {
  SICK       // Sakit
  VACATION   // Bakasyon
  EMERGENCY  // Emergency
  MATERNITY  // Para sa mga nanay
  PATERNITY  // Para sa mga tatay
}

enum OTStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

// Status para sa mismong Correction Request
enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// Para malaman kung anong part ang gustong itama (Optional pero helpful)
enum CorrectionType {
  TIME_IN
  TIME_OUT
  BOTH
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum CivilStatus {
  SINGLE
  MARRIED
  WIDOWED
  SEPARATED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  PROJECT_BASED
  INTERN
}